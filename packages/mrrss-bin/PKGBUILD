pkgname=mrrss-bin
pkgver=1.3.39
pkgrel=1
pkgdesc='Modern standalone RSS reader with AI-assisted reading features'
arch=('x86_64')
url='https://github.com/DevXDojo/MrRSS'
license=('GPL-3.0-only')
depends=(
  'glib2'
  'glibc'
  'gtk4'
  'libx11'
  'libsoup3'
  'webkitgtk-6.0'
)
provides=("mrrss=${pkgver}")
conflicts=('mrrss')
options=('!strip')
source=(
  "MrRSS-${pkgver}-linux-amd64.tar.gz::${url}/releases/download/v${pkgver}/MrRSS-${pkgver}-linux-amd64.tar.gz"
  "mrrss-${pkgver}.png::https://raw.githubusercontent.com/DevXDojo/MrRSS/v${pkgver}/imgs/logo-rounded.png"
  "LICENSE-${pkgver}::https://raw.githubusercontent.com/DevXDojo/MrRSS/v${pkgver}/LICENSE"
  'mrrss.desktop'
)
sha256sums=('9c1f5d1f2558a72ee9fec0c0c098bf205aa67f8a9e3a216f0ef8ea1912db7092'
            '4bc59cd33bce983a9b5a21f17e65608f14d21f45b6a1adeb3583d73f28bb0496'
            '3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986'
            '65b714dc0e02eb44a310a3823e96188512199e3cfbcb6fd256411fb110165f96')

package() {
  install -Dm755 "${srcdir}/MrRSS" "${pkgdir}/usr/bin/mrrss"
  install -Dm644 "${srcdir}/mrrss.desktop" \
    "${pkgdir}/usr/share/applications/mrrss.desktop"
  install -Dm644 "${srcdir}/mrrss-${pkgver}.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/mrrss.png"
  install -Dm644 "${srcdir}/LICENSE-${pkgver}" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
